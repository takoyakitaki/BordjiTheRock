    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].choices.Array.data[0].choiceText
      value: . . . .
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].choices.Array.data[1].choiceText
      value: "\u0E41\u0E25\u0E49\u0E27\u0E01\u0E47?"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].sentences.Array.data[0].sentence
      value: "\u0E0A\u0E32\u0E22\u0E27\u0E31\u0E22\u0E01\u0E25\u0E32\u0E07\u0E04\u0E19\u0E01\u0E49\u0E32\u0E27\u0E25\u0E07\u0E1A\u0E31\u0E19\u0E44\u0E14\u0E0A\u0E49\u0E32
        \u0E46 \u0E14\u0E27\u0E07\u0E15\u0E32\u0E02\u0E2D\u0E07\u0E40\u0E02\u0E32\u0E41\u0E14\u0E07\u0E01\u0E48\u0E33"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].sentences.Array.data[1].sentence
      value: "\u0E40\u0E02\u0E32\u0E1E\u0E39\u0E14\u0E14\u0E49\u0E27\u0E22\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E2A\u0E31\u0E48\u0E19\u0E27\u0E48\u0E32
        \n\u201C\u0E20\u0E23\u0E23\u0E22\u0E32\u0E1C\u0E21\u2026 \u0E0A\u0E2D\u0E1A\u0E23\u0E49\u0E2D\u0E07\u0E40\u0E1E\u0E25\u0E07\r\n\u0E04\u0E37\u0E19\u0E01\u0E48\u0E2D\u0E19\u0E40\u0E18\u0E2D\u0E23\u0E49\u0E2D\u0E07\u0E40\u0E1A\u0E32
        \u0E46 \u0E41\u0E15\u0E48\u0E21\u0E31\u0E19\u0E01\u0E47\u0E41\u0E04\u0E48\u0E40\u0E1E\u0E25\u0E07\u0E01\u0E25\u0E48\u0E2D\u0E21\u0E40\u0E14\u0E47\u0E01\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].sentences.Array.data[2].sentence
      value: "\u201C\u0E1E\u0E27\u0E01\u0E21\u0E31\u0E19\u0E44\u0E14\u0E49\u0E22\u0E34\u0E19\u2026
        \u0E41\u0E25\u0E49\u0E27\u0E40\u0E18\u0E2D\u0E01\u0E47...\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].sentences.Array.data[3].sentence
      value: "\r\n\u201C\u0E09\u0E31\u0E19\u0E2D\u0E22\u0E32\u0E01\u0E15\u0E30\u0E42\u0E01\u0E19
        \u0E2D\u0E22\u0E32\u0E01\u0E27\u0E34\u0E48\u0E07 \u0E2D\u0E22\u0E32\u0E01\u0E17\u0E33\u0E2D\u0E30\u0E44\u0E23\u0E2A\u0E31\u0E01\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E17\u0E35\u0E48\u0E40\u0E1B\u0E47\u0E19\u0E02\u0E2D\u0E07\u0E09\u0E31\u0E19\u0E40\u0E2D\u0E07
        \u0E41\u0E15\u0E48\u0E09\u0E31\u0E19\u0E01\u0E47\u0E17\u0E33\u0E44\u0E14\u0E49\u0E41\u0E04\u0E48\u2026
        \u0E2B\u0E32\u0E22\u0E43\u0E08\u0E15\u0E32\u0E21\u0E04\u0E33\u0E2A\u0E31\u0E48\u0E07\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].sentences.Array.data[4].sentence
      value: "\u0E04\u0E27\u0E32\u0E21\u0E40\u0E07\u0E35\u0E22\u0E1A\u0E1B\u0E01\u0E04\u0E25\u0E38\u0E21\u0E2D\u0E38\u0E42\u0E21\u0E07\u0E04\u0E4C
        \u0E40\u0E23\u0E22\u0E4C\u0E42\u0E01\u0E30\u0E21\u0E2D\u0E07\u0E40\u0E14\u0E47\u0E01\u0E2A\u0E32\u0E27\u0E15\u0E23\u0E07\u0E2B\u0E19\u0E49\u0E32\u0E01\u0E48\u0E2D\u0E19\u0E08\u0E30\u0E14\u0E35\u0E14\u0E2A\u0E32\u0E22\u0E01\u0E35\u0E15\u0E32\u0E23\u0E4C\u0E40\u0E1A\u0E32
        \u0E46 \u0E2B\u0E19\u0E36\u0E48\u0E07\u0E04\u0E23\u0E31\u0E49\u0E07\u0E08\u0E19\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E2A\u0E30\u0E17\u0E49\u0E2D\u0E19\u0E14\u0E31\u0E07\u0E01\u0E36\u0E01\u0E01\u0E49\u0E2D\u0E07\u0E01\u0E31\u0E07\u0E27\u0E32\u0E25\u0E44\u0E1B\u0E17\u0E31\u0E48\u0E27\u0E17\u0E35\u0E48\u0E41\u0E2B\u0E48\u0E07\u0E19\u0E35\u0E49"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].sentences.Array.data[5].sentence
      value: "\u201C\u0E07\u0E31\u0E49\u0E19\u0E04\u0E37\u0E19\u0E19\u0E35\u0E49\u2026
        \u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E02\u0E2D\u0E40\u0E1E\u0E25\u0E07\u0E01\u0E47\u0E44\u0E14\u0E49\u0E04\u0E48\u0E30\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].sentences.Array.data[6].sentence
      value: "\u201C\u0E41\u0E04\u0E48\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E43\u0E2B\u0E49\u0E21\u0E31\u0E19\u0E44\u0E2B\u0E25\u0E2D\u0E2D\u0E01\u0E21\u0E32\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].sentences.Array.data[7].sentence
      value: "\u0E40\u0E18\u0E2D\u0E19\u0E31\u0E48\u0E07\u0E19\u0E34\u0E48\u0E07\u0E01\u0E48\u0E2D\u0E19\u0E40\u0E17\u0E49\u0E32\u0E08\u0E30\u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E04\u0E32\u0E30\u0E1E\u0E37\u0E49\u0E19\u0E42\u0E14\u0E22\u0E44\u0E21\u0E48\u0E23\u0E39\u0E49\u0E15\u0E31\u0E27"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].sentences.Array.data[8].sentence
      value: "\u0E08\u0E31\u0E07\u0E2B\u0E27\u0E30\u0E40\u0E23\u0E34\u0E48\u0E21\u0E15\u0E49\u0E19\u0E0A\u0E49\u0E32
        \u0E46 \u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E2B\u0E31\u0E27\u0E43\u0E08\u0E17\u0E35\u0E48\u0E40\u0E15\u0E49\u0E19\u0E2D\u0E48\u0E2D\u0E19\u0E41\u0E23\u0E07"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].sentences.Array.data[9].sentence
      value: "\u0E08\u0E31\u0E07\u0E2B\u0E27\u0E30\u0E40\u0E23\u0E34\u0E48\u0E21\u0E15\u0E49\u0E19\u0E0A\u0E49\u0E32
        \u0E46 \u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E2B\u0E31\u0E27\u0E43\u0E08\u0E17\u0E35\u0E48\u0E40\u0E15\u0E49\u0E19\u0E2D\u0E48\u0E2D\u0E19\u0E41\u0E23\u0E07"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[1].choices.Array.data[0].choiceText
      value: . . . .
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[1].choices.Array.data[1].choiceText
      value: "\u0E41\u0E25\u0E49\u0E27\u0E01\u0E47?"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[1].sentences.Array.data[0].sentence
      value: "\u0E04\u0E27\u0E32\u0E21\u0E40\u0E07\u0E35\u0E22\u0E1A\u0E1B\u0E01\u0E04\u0E25\u0E38\u0E21\u0E17\u0E31\u0E49\u0E07\u0E2A\u0E16\u0E32\u0E19\u0E35"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[1].sentences.Array.data[1].sentence
      value: "\u0E40\u0E23\u0E22\u0E4C\u0E42\u0E01\u0E30\u0E0A\u0E30\u0E07\u0E31\u0E01
        \u0E40\u0E18\u0E2D\u0E44\u0E21\u0E48\u0E23\u0E39\u0E49\u0E27\u0E48\u0E32\u0E04\u0E27\u0E23\u0E08\u0E30\u0E17\u0E33\u0E2D\u0E30\u0E44\u0E23\u0E15\u0E48\u0E2D
        \u0E04\u0E27\u0E23\u0E08\u0E30\u0E1B\u0E25\u0E2D\u0E1A\u0E40\u0E02\u0E32?
        \u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E18\u0E2D\u0E04\u0E27\u0E23\u0E08\u0E30\u0E40\u0E23\u0E34\u0E48\u0E21\u0E17\u0E33\u0E2D\u0E30\u0E44\u0E23\u0E2A\u0E31\u0E01\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E14\u0E35"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[1].sentences.Array.data[2].sentence
      value: "\u0E41\u0E15\u0E48\u0E41\u0E25\u0E49\u0E27 \u0E0A\u0E32\u0E22\u0E15\u0E23\u0E07\u0E2B\u0E19\u0E49\u0E32\u0E2B\u0E22\u0E34\u0E1A\u0E01\u0E23\u0E30\u0E14\u0E32\u0E29\u0E40\u0E01\u0E48\u0E32
        \u0E46 \u0E2D\u0E2D\u0E01\u0E21\u0E32 \u0E40\u0E1C\u0E22\u0E43\u0E2B\u0E49\u0E40\u0E2B\u0E47\u0E19\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E40\u0E1E\u0E25\u0E07\u0E17\u0E35\u0E48\u0E20\u0E23\u0E23\u0E22\u0E32\u0E02\u0E2D\u0E07\u0E40\u0E02\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E19\u0E40\u0E02\u0E35\u0E22\u0E19\u0E44\u0E27\u0E49"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[1].sentences.Array.data[3].sentence
      value: "\u0E19\u0E35\u0E48\u0E04\u0E07\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E23\u0E31\u0E49\u0E07\u0E41\u0E23\u0E01
        \u0E17\u0E35\u0E48\u0E08\u0E30\u0E44\u0E14\u0E49\u0E1A\u0E23\u0E23\u0E40\u0E25\u0E07\u0E1A\u0E17\u0E40\u0E1E\u0E25\u0E07\u0E17\u0E35\u0E48\u0E40\u0E1B\u0E47\u0E19\u0E02\u0E2D\u0E07\u0E25\u0E39\u0E01\u0E04\u0E49\u0E32\u0E42\u0E14\u0E22\u0E15\u0E23\u0E07"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[1].sentences.Array.data[4].sentence
      value: "\u201C\u0E07\u0E31\u0E49\u0E19\u0E04\u0E37\u0E19\u0E19\u0E35\u0E49\u2026
        \u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E02\u0E2D\u0E40\u0E1E\u0E25\u0E07\u0E01\u0E47\u0E44\u0E14\u0E49\u0E04\u0E48\u0E30\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[1].sentences.Array.data[5].sentence
      value: "\u201C\u0E41\u0E04\u0E48\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E43\u0E2B\u0E49\u0E21\u0E31\u0E19\u0E44\u0E2B\u0E25\u0E2D\u0E2D\u0E01\u0E21\u0E32\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[1].sentences.Array.data[6].sentence
      value: "\u0E08\u0E31\u0E07\u0E2B\u0E27\u0E30\u0E40\u0E23\u0E34\u0E48\u0E21\u0E15\u0E49\u0E19\u0E0A\u0E49\u0E32
        \u0E46 \u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E2B\u0E31\u0E27\u0E43\u0E08\u0E17\u0E35\u0E48\u0E40\u0E15\u0E49\u0E19\u0E2D\u0E48\u0E2D\u0E19\u0E41\u0E23\u0E07"
      objectReference: {fileID: 0}
