    - target: {fileID: 6811229540983028819, guid: 959d63ece5e5242469162dc27f30d156, type: 3}
      propertyPath: passDialogueBlocks.Array.data[0].sentences.Array.data[4].sentence
      value: "\u0E40\u0E23\u0E22\u0E4C\u0E42\u0E01\u0E30(\u0E1E\u0E36\u0E21\u0E1E\u0E33):\r\n\u201C\u0E16\u0E36\u0E07\u0E07\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E19\u0E31\u0E49\u0E19\u0E01\u0E47\u0E22\u0E31\u0E07\u0E21\u0E35
        \u2018Echo\u2019 \u0E2D\u0E22\u0E39\u0E48\u0E22\u0E31\u0E07\u0E44\u0E07\u0E25\u0E48\u0E30\u0E04\u0E30\r\n\u0E21\u0E35\u0E40\u0E1E\u0E35\u0E22\u0E07\u0E41\u0E15\u0E48\u0E2A\u0E34\u0E48\u0E07\u0E19\u0E35\u0E49
        \u0E21\u0E35\u0E41\u0E04\u0E48 '\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E2A\u0E30\u0E17\u0E49\u0E2D\u0E19'\u2026
