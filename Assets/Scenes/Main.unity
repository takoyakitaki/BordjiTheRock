      propertyPath: passDialogueBlocks.Array.data[1].sentences.Array.data[3].sentence
      value: "\u201C\u0E1C\u0E21\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E43\u0E2B\u0E49\u0E42\u0E25\u0E01\u0E40\u0E07\u0E35\u0E22\u0E1A\r\n\u0E40\u0E1E\u0E23\u0E32\u0E30\u0E1C\u0E21\u0E01\u0E25\u0E31\u0E27\u201D"
