      propertyPath: passDialogueBlocks.Array.data[0].sentences.Array.data[8].sentence
      value: "\u0E40\u0E02\u0E32\u0E19\u0E31\u0E48\u0E07\u0E19\u0E34\u0E48\u0E07\u0E19\u0E49\u0E33\u0E15\u0E32\u0E44\u0E2B\u0E25\u0E40\u0E07\u0E35\u0E22\u0E1A
