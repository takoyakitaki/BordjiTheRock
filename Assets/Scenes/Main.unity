      value: "\u0E40\u0E1E\u0E25\u0E07\u0E40\u0E23\u0E34\u0E48\u0E21\u0E15\u0E49\u0E19\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E41\u0E1C\u0E48\u0E27\u0E40\u0E1A\u0E32
