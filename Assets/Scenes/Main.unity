    - target: {fileID: 7042492156981636974, guid: 0286f52909679db4a9aa7101624c65b2, type: 3}
      propertyPath: dialogueBlocks.Array.data[0].choices.Array.data[0].choiceText
      value: "\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E43\u0E2B\u0E49\u0E0A\u0E48\u0E27\u0E22\u0E44\u0E2B\u0E21\u0E04\u0E30?"
