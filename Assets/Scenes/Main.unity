      propertyPath: passDialogueBlocks.Array.data[0].sentences.Array.data[9].sentence
      value: "\u201C\u2026\u0E1C\u0E21\u0E22\u0E31\u0E07\u0E21\u0E35\u0E0A\u0E35\u0E27\u0E34\u0E15\u0E2D\u0E22\u0E39\u0E48\u201D"
